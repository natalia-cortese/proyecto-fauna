				{
					"type": "script",
					"language": "javascript",
					"script": [
						"runtime.timeScale = 1;",
						"const JAULAS = 3;",
						"const region = runtime.globalVars.REGION || \"puna\";",
						"runtime.globalVars.REGION = region;",
						"if (!runtime.globalVars.SEMILLA)",
						"\truntime.globalVars.SEMILLA = Math.floor(Math.random() * 1e9) + 1;",
						"const mapa = generarMapa({ jaulas: JAULAS, semilla: runtime.globalVars.SEMILLA });",
						"construirLaberinto(runtime, mapa);",
						"elegirAnimales(region, runtime.globalVars.SEMILLA, JAULAS);"
					]
				}
			],
