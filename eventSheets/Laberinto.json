					"objectClass": "System",
					"sid": 756185813850413
				}
			],
			"actions": [
				{
					"type": "script",
					"script": "const JAULAS = 3;\nif (!runtime.globalVars.SEMILLA)\n\truntime.globalVars.SEMILLA = Math.floor(Math.random() * 1e9) + 1;\nconst mapa = generarMapa({ jaulas: JAULAS, semilla: runtime.globalVars.SEMILLA });\nconstruirLaberinto(runtime, mapa);\nelegirAnimales(runtime.globalVars.REGION, runtime.globalVars.SEMILLA, JAULAS);"
				}
			],
			"sid": 875703824961286
		},
