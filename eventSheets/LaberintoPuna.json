		{
			"eventType": "include",
			"includeSheet": "Event sheet 1"
		},
		{
			"eventType": "comment",
			"text": "Laberinto de la Puna. Arma el mapa con generarMapa(); al abrir todas las jaulas llama alCompletarLaberinto (otro laberinto de esta región o EndGame)."
		},
		{
			"eventType": "block",
			"conditions": [
				{
					"id": "on-start-of-layout",
					"objectClass": "System",
					"sid": 756185813850413
				}
			],
			"actions": [
				{
					"type": "script",
					"language": "javascript",
					"script": [
						"runtime.globalVars.REGION = runtime.globalVars.REGION || \"puna\";",
						"const JAULAS = 3;",
						"if (!runtime.globalVars.SEMILLA)",
						"\truntime.globalVars.SEMILLA = Math.floor(Math.random() * 1e9) + 1;",
						"const mapa = generarMapa({ jaulas: JAULAS, semilla: runtime.globalVars.SEMILLA });",
						"construirLaberinto(runtime, mapa);",
						"elegirAnimales(\"puna\", runtime.globalVars.SEMILLA, JAULAS);"
					]
				}
			],
			"sid": 875703824961286
		},
